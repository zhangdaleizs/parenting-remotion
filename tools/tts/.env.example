# 速创猫 TTS key 模板 —— 复制成 .env 并填入真实 key
#
#   cp tools/tts/.env.example tools/tts/.env
#
# key 获取：打开 https://agent.ai-tools.cn/speech-synthesis
#          F12 → Network → 任一请求的 Request Headers → x-api-key
#
# ⚠️ .env 已被 .gitignore 排除，不要把它提交上去；
#    也可以改用同名环境变量 SPEECH_API_KEY（优先级更高）。
SPEECH_API_KEY=sk-your-key-here
